# ---- Database -------------------------------------------------------------
# Local throwaway MySQL (npm run db:dev): mysql://club_app:club_dev_password@127.0.0.1:3307/club_management
# Dedicated, least-privilege MySQL user that only has access to club_management.
DATABASE_URL="mysql://club_app:CHANGE_ME@127.0.0.1:3306/club_management"
DATABASE_POOL_SIZE=10

# ---- App ----------------------------------------------------------------
# Public origin of the site (used for links in PDFs and secure cookies).
APP_URL="https://club.rasatech.in"
# Port PM2 binds to on 127.0.0.1 (pick a free one: ss -ltn).
APP_PORT=3105
# Absolute path OUTSIDE the web root where bills/invoices/payment proofs are stored.
UPLOAD_DIR="/var/lib/club-management/uploads"
# Max size per uploaded file in megabytes.
UPLOAD_MAX_MB=5
# Stable key for Server Action closure encryption (openssl rand -base64 32).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ---- First admin (used by `npm run db:seed` only) --------------------------
SEED_ADMIN_EMAIL="admin@club.local"
SEED_ADMIN_PASSWORD="change-this-long-password"
SEED_ADMIN_NAME="Club Admin"
# Set to "true" to also insert demo members, events and transactions (empty database only).
SEED_DEMO_DATA="true"
